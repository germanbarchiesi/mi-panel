# Copia este fichero a .env.local para desarrollo. En producción, estas variables
# se definen SOLO en Vercel (Settings > Environment Variables). Nunca en el código ni en el chat.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave publicable (sb_publishable_...). NO uses nunca la service_role / secret key aquí.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Único email que puede entrar en el panel
ALLOWED_EMAIL=tu-correo@gmail.com

# --- Fase 2: Google Calendar ---
# Google Cloud > Google Auth Platform > Clientes (el mismo cliente OAuth que usa el login)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
# 32 bytes aleatorios en base64 (cifra el permiso de Google en la base de datos)
TOKEN_ENCRYPTION_KEY=

# --- Fase 3: Mis tareas (API v1, solo lectura) ---
# Dirección de Mis tareas en Vercel, sin barra final
MIS_TAREAS_API_URL=https://mis-tareas-peach.vercel.app
# Clave de solo lectura creada en Mis tareas > Ajustes > Conexión con Mi Panel (mt_ + 64 hex). Solo en Vercel.
MIS_TAREAS_API_KEY=

# --- Fase 4: Finanzas (selector de Google para elegir el Excel) ---
# Clave de API restringida a la web de Vercel y solo a Google Picker API
GOOGLE_PICKER_API_KEY=
# Número (no ID) del proyecto de Google Cloud «mi-panel»
GOOGLE_PROJECT_NUMBER=
