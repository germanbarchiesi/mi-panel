# Copia este fichero a .env.local para desarrollo. En producción, estas variables
# se definen SOLO en Vercel (Settings > Environment Variables). Nunca en el código ni en el chat.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave publicable (sb_publishable_...). NO uses nunca la service_role / secret key aquí.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Único email que puede entrar en el panel
ALLOWED_EMAIL=tu-correo@gmail.com

# --- Fase 2: Google Calendar ---
# Google Cloud > Google Auth Platform > Clientes (el mismo cliente OAuth que usa el login)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
# 32 bytes aleatorios en base64 (cifra el permiso de Google en la base de datos)
TOKEN_ENCRYPTION_KEY=
